# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-stage4-local/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude local settings
.claude/

# Claude Code session remnants and backup files
tmpclaude-*-cwd/
*.bak
*.tmp
*.backup

# Temporary debug documents
DEBUG_GUARD_CHANGES.md

# local caches
.cache/

# development server logs
/dev.log

# cascade generation debug logs (re-created during API development)
/cascade-debug/

# Model comparison captures and results (local only, contains business data)
/model-comparison/captures/
/model-comparison/results/

# AI evaluation outputs and run logs (regenerable; eval/ test code stays tracked)
/eval/**/results*/

# Claude Code instruction file (changes frequently, not part of repo)
prompt.txt


# 検証用DB（PGlite）のビルド出力（評価専用・Git管理外）
/eval/db/.build/

# ブラウザ検証用のビルド出力（評価専用・Git管理外）
/eval/stage3-browser/out/
/eval/integration/e2e/.build/
/eval/integration/e2e/.results/
